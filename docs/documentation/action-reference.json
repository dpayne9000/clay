        },
        "contentKey": {
          "description": "Context key holding AI-generated content (code fences stripped automatically)",
          "type": "string"
        },
        "file": {
          "description": "Output file path. Supports {placeholder} interpolation",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "contentKey",
        "file"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "API"
        },
        "id": {
          "description": "Output key for the response body (parsed JSON or raw text)",
          "type": "string"
        },
        "endpoint": {
          "description": "Full URL of the API endpoint",
          "type": "string"
        },
        "method": {
          "description": "HTTP method: get, post, put, patch, delete",
          "type": "string",
          "default": "get"
        },
        "params": {
          "description": "URL query parameters as a JSON object",
          "type": "object"
        },
        "headers": {
          "description": "HTTP headers as a JSON object",
          "type": "object"
        },
        "data": {
          "description": "Request body, sent as JSON",
          "type": "object"
        }
      },
      "required": [
        "type",
        "id",
        "endpoint"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "readFile"
        },
        "id": {
          "description": "Output key for the file's text content",
          "type": "string"
        },
        "file": {
          "description": "Input path relative to root. Supports {placeholder} interpolation",
