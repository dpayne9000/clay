          "default": "duckduckgo"
        },
        "maxResults": {
          "description": "Maximum results to return",
          "type": "integer",
          "default": 5
        },
        "apiKey": {
          "description": "Required for google and bing engines",
          "type": "string"
        },
        "cx": {
          "description": "Custom Search Engine ID \u2014 required for google engine",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "listSites"
        },
        "id": {
          "description": "Output key for newline-separated .json filenames in webactions/",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
