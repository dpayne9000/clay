          "default": "output"
        },
        "encoding": {
          "description": "Text encoding used to read the file",
          "type": "string",
          "default": "utf-8"
        },
        "maxBytes": {
          "description": "Reject the read if the file exceeds this many bytes",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "id",
        "file"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "writeFile"
        },
        "id": {
          "description": "Output key for the written file path",
          "type": "string"
        },
        "file": {
          "description": "Output path relative to root. Supports {placeholder} interpolation",
          "type": "string"
        },
        "content": {
          "description": "Context key holding the content to write verbatim",
          "type": "string"
        },
        "root": {
          "description": "Directory the path resolves under; paths may not escape it",
          "type": "string",
          "default": "output"
        },
        "encoding": {
          "description": "Text encoding used to write the file",
