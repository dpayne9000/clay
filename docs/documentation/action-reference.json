          "default": false
        },
        "ensureFinalNewline": {
          "description": "Ensure the written content ends with exactly one newline",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "type",
        "id",
        "file",
        "content"
      ],
      "additionalProperties": true
    },
