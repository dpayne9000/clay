{
  "$schema": "https://json-schema.org/draft/2020-12",
  "title": "ClayAction",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sendAlert"
        },
        "id": {
          "description": "Output key for alert delivery confirmation",
          "type": "string"
        },
        "channel": {
          "description": "Delivery channel: email, webhook, or file",
          "type": "string"
        },
        "message": {
          "description": "Context key or literal text. Supports {placeholder}",
          "type": "string"
        },
        "level": {
          "description": "Alert level: info, warning, or critical",
          "type": "string",
          "default": "info"
        },
        "to": {
          "description": "Override recipient for email channel. Supports {placeholder}",
          "type": "string"
        },
        "url": {
          "description": "Override URL for webhook channel. Supports {placeholder}",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "channel",
        "message"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "loadContext"
        },
        "id": {
          "description": "Required but ignored \u2014 all keys from the file merge into context directly",
          "type": "string"
        },
        "file": {
          "description": "Path to a JSON file whose top-level keys are merged into the workflow context",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "file"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "createAgentAction"
        },
        "id": {
          "description": "Output key for the created file path",
          "type": "string"
        },
        "actionName": {
          "description": "kebab-case or snake_case name matching [a-z][a-z0-9_-]{1,39}",
          "type": "string"
        },
        "content": {
          "description": "Context key holding the Python source for the new action module",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "actionName",
        "content"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sendEmail"
        },
        "id": {
          "description": "Output key for the send confirmation",
          "type": "string"
        },
        "to": {
          "description": "Recipient email address. Supports {placeholder}",
          "type": "string"
        },
        "body": {
          "description": "Context key or literal text for email body. Supports {placeholder}",
          "type": "string"
        },
        "subject": {
          "description": "Subject line. Supports {placeholder}",
          "type": "string",
          "default": "No Subject"
        },
        "format": {
          "description": "Email body format: 'plain' or 'html'",
          "type": "string",
          "default": "plain"
        }
      },
      "required": [
        "type",
        "id",
        "to",
        "body"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "humanShell"
        },
        "id": {
          "description": "Output key for stdout",
          "type": "string"
        },
        "command": {
          "description": "Command template. Supports {placeholder} interpolation",
          "type": "string"
        },
        "timeout": {
          "description": "Seconds before the process is killed",
          "type": "integer",
          "default": 60
        },
        "skipValue": {
          "description": "If the resolved command equals this value, skip without prompting",
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "type",
        "id",
        "command"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "loop"
        },
        "id": {
          "description": "Output key for the final iteration's outputKey value",
          "type": "string"
        },
        "file": {
          "description": "Path to the sub-workflow JSON file to run each iteration",
          "type": "string"
        },
        "iterations": {
          "description": "Max iterations. 0 or absent = infinite (requires continueKey)",
          "type": "integer",
          "default": 0
        },
        "continueKey": {
          "description": "Sub-workflow output key checked for stop signal (false/done/0/no/stop/empty)",
          "type": "string"
        },
        "outputKey": {
          "description": "Sub-workflow output key appended to loop_history each iteration",
          "type": "string",
          "default": "final"
        }
      },
      "required": [
        "type",
        "id",
        "file"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "writeMemory"
        },
        "id": {
          "description": "Output key for the saved entry ID",
          "type": "string"
        },
        "namespace": {
          "description": "Directory namespace to write into (e.g. developer)",
          "type": "string"
        },
        "content": {
          "description": "Context key holding the text content to persist",
          "type": "string"
        },
        "tagsKey": {
          "description": "Context key holding a comma-separated tag string. Auto-derived if absent",
          "type": "string"
        },
        "entryId": {
          "description": "Override the generated entry ID. Overwrites existing entry if reused",
          "type": "string"
        },
        "source": {
          "description": "Metadata field recorded in the JSON entry",
          "type": "string",
          "default": "workflow"
        },
        "skillset": {
          "description": "If set, also saves the content as a skill file in this skillset",
          "type": "string"
        },
        "skillExtension": {
          "description": "File extension for the dual-written skill file",
          "type": "string",
          "default": "py"
        }
      },
      "required": [
        "type",
        "id",
        "namespace",
        "content"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "searchMemory"
        },
        "id": {
          "description": "Output key for formatted matching entries",
          "type": "string"
        },
        "namespace": {
          "description": "Namespace to search",
          "type": "string"
        },
        "query": {
          "description": "Search query (tag matches score 3\u00d7, content matches 1\u00d7)",
          "type": "string"
        },
        "queryKey": {
          "description": "Context key holding the query. Takes precedence over query",
          "type": "string"
        },
        "maxResults": {
          "description": "Maximum entries to return",
          "type": "integer",
          "default": 5
        }
      },
      "required": [
        "type",
        "id",
        "namespace"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "listMemory"
        },
        "id": {
          "description": "Output key for newline-separated entry IDs with tags",
          "type": "string"
        },
        "namespace": {
          "description": "Namespace to list entries from",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "namespace"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "readMemory"
        },
        "id": {
          "description": "Output key for the formatted entry content",
          "type": "string"
        },
        "namespace": {
          "description": "Namespace the entry lives in",
          "type": "string"
        },
        "entryId": {
          "description": "ID of the entry to read",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "namespace",
        "entryId"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "runCode"
        },
        "id": {
          "description": "Output key for stdout",
          "type": "string"
        },
        "language": {
          "description": "Interpreter: python, bash, node, sh",
          "type": "string",
          "default": "python"
        },
        "source": {
          "description": "Inline source code string",
          "type": "string"
        },
        "sourceKey": {
          "description": "Context key holding the source code. Takes precedence over source",
          "type": "string"
        },
        "stdin": {
          "description": "Context key whose value is piped as stdin to the process",
          "type": "string"
        },
        "timeout": {
          "description": "Seconds before the process is killed",
          "type": "integer",
          "default": 30
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "shell"
        },
        "id": {
          "description": "Output key for stdout",
          "type": "string"
        },
        "command": {
          "description": "Shell command. Supports {placeholder} interpolation",
          "type": "string"
        },
        "timeout": {
          "description": "Seconds before the process is killed",
          "type": "integer",
          "default": 30
        }
      },
      "required": [
        "type",
        "id",
        "command"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "writeSkill"
        },
        "id": {
          "description": "Output key for the saved file path",
          "type": "string"
        },
        "skillset": {
          "description": "Skillset directory name under skills/",
          "type": "string"
        },
        "name": {
          "description": "Skill filename without extension. Supports {placeholder} interpolation",
          "type": "string"
        },
        "content": {
          "description": "Context key holding the skill content to write",
          "type": "string"
        },
        "extension": {
          "description": "File extension: py, json, txt, sh",
          "type": "string",
          "default": "py"
        },
        "skipValue": {
          "description": "If the resolved name equals this value, skip without writing",
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "type",
        "id",
        "skillset",
        "name",
        "content"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "listSkills"
        },
        "id": {
          "description": "Output key for newline-separated filenames with tags",
          "type": "string"
        },
        "skillset": {
          "description": "Skillset directory name under skills/",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "skillset"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "removeSkill"
        },
        "id": {
          "description": "Output key for the removed file path",
          "type": "string"
        },
        "skillset": {
          "description": "Skillset directory name under skills/",
          "type": "string"
        },
        "name": {
          "description": "Skill filename without extension. Supports {placeholder} interpolation",
          "type": "string"
        },
        "extension": {
          "description": "File extension",
          "type": "string",
          "default": "py"
        }
      },
      "required": [
        "type",
        "id",
        "skillset",
        "name"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "searchSkills"
        },
        "id": {
          "description": "Output key for newline-separated matching filenames ranked by relevance",
          "type": "string"
        },
        "skillset": {
          "description": "Skillset directory name under skills/",
          "type": "string"
        },
        "query": {
          "description": "Search query \u2014 keywords matched against skill filenames",
          "type": "string"
        },
        "queryKey": {
          "description": "Context key holding the query. Takes precedence over query",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "skillset"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "deriveTags"
        },
        "id": {
          "description": "Output key for the comma-separated tag string",
          "type": "string"
        },
        "contentKey": {
          "description": "Context key holding the primary text to analyse",
          "type": "string"
        },
        "content": {
          "description": "Inline fallback text if contentKey is absent or empty",
          "type": "string"
        },
        "contextKey": {
          "description": "Context key for secondary text, weighted at 40% of primary",
          "type": "string"
        },
        "maxTags": {
          "description": "Maximum number of tags to return",
          "type": "integer",
          "default": 6
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "telegram"
        },
        "id": {
          "description": "telegram is an action that persists, and hosts a telegram bot channel. It does not require params other than type=telegram and runs until manually stopped",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "browseWeb"
        },
        "id": {
          "description": "Output key for the extracted page text",
          "type": "string"
        },
        "url": {
          "description": "URL to fetch (http/https only). Supports {placeholder} interpolation",
          "type": "string"
        },
        "maxChars": {
          "description": "Maximum characters of extracted text to return",
          "type": "integer",
          "default": 4000
        },
        "siteKey": {
          "description": "If set, saves URL and 500-char preview to webactions/{siteKey}.json",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "url"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "searchWeb"
        },
        "id": {
          "description": "Output key for the formatted numbered result list",
          "type": "string"
        },
        "query": {
          "description": "Search query string. Supports {placeholder} interpolation",
          "type": "string"
        },
        "queryKey": {
          "description": "Context key holding the query. Takes precedence over query",
