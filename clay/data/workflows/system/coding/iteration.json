{
  "defaults": {
    "turn_summary": "",
    "build_progress": "(nothing has been built for this request)"
  },
  "workflow": {
    "steps": ["context", "request", "route", "design", "write_plan", "construct", "settle"]
  },
  "actionSets": {
    "context": [
      {
        "id": "coding_context",
        "type": "loadContext",
        "visible": false,
        "file": "./protocol.json"
      },
      {
        "id": "coding_training",
        "type": "loadContext",
        "visible": false,
        "file": "./training.json"
      }
    ],
    "request": [
      {
        "id": "user_request",
        "type": "humanDecision",
        "prompt": "\nDescribe the software project to create or modify: behavior, interface, technology preferences, constraints, and completion condition.\n> "
      }
    ],
    "route": [
      {
        "id": "keep_going",
        "type": "matchText",
        "visible": false,
        "source": "user_request",
        "values": ["quit", "exit", "bye", "done", "stop", "q", ":q", "goodbye"],
        "onMatch": "no",
        "onMiss": "yes",
        "includedData": ["user_request"]
      }
    ],
    "design": [
      {
        "id": "design_contract",
        "type": "scramda2",
        "when": "keep_going",
        "max_tokens": 4100,
        "prompt": "Create a plan file for a workflow that satisfies these user requirements: {user_request}\n\nEach checklist item must state two things: which action(s) it adds or configures, and what it does for these specific requirements.\n\nReturn only the PLAN.md file. The first line must be exactly \"```markdown PLAN.md\". The last line must be exactly \"```\". Do not output text or additional fences outside the PLAN.md fence.",
        "examples": {"override": "plan_file_examples"},
        "includedData": ["user_request", "design_rules", "project_rules", "plan_file_examples"]
      }
    ],
    "write_plan": [
      {
        "id": "plan_file_written",
        "type": "applyFileWrites",
        "when": "keep_going",
        "reply": "design_contract",
        "maxFiles": 1,
        "includedData": ["design_contract"]
      }
    ],
    "construct": [
      {
        "id": "construction_result",
        "type": "loop",
        "when": "plan_file_written",
        "file": "./file-iteration.json",
        "iterations": 30,
        "continueKey": "construction_decision",
        "outputKey": "build_progress",
        "merge": true,
        "includedData": ["user_request", "design_contract", "plan_file_written", "build_progress", "file_rules", "project_rules", "generation_rules", "file_generation_examples", "plan_update_examples"]
      }
    ],
    "settle": [
      {
        "id": "turn_summary",
        "type": "scramda2",
        "when": "keep_going",
        "visible": true,
        "modelProfile": "code",
        "max_tokens": 500,
        "prompt": "REQUEST:\n{user_request}\n\nBUILD RECORD:\n{build_progress}\n\nReport what was created or changed, verification performed and its result, and any remaining work. Missing write or verification records mean those actions did not occur. Base the report only on BUILD RECORD. Keep it concise.",
        "includedData": ["user_request", "build_progress"]
      }
    ]
  }
}
